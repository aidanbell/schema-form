{
  "name": "@aidanbell/schema-form",
  "version": "0.1.0",
  "description": "Headless schema-driven forms: parse, Zod validation, and useSchemaForm",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "peerDependencies": {
    "@hookform/resolvers": ">=3.0.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "react-hook-form": "^7.50.0"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "valibot": "^1.4.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
